  "parse_rules": {
    "tags": "파이프(|) 구분 배열",
    "trigger_grammar": "PREFIX[:FUNC(ARG)][OP VALUE] — PREFIX∈{ALWAYS,PER,IF,UPGRADE,CHARGES,TURNEND}, FUNC∈{ADJ,COUNT,SUM,REMOVE_SNOW,CONSUME}, ARG∈{EMPTY,SNOW,BASE,TAG:*,ADJ_MIN_GEN,LV}, OP∈{>=,<=}",
    "trigger_semantics": {
      "ALWAYS": "무조건 적용 (BaseValue/MultValue 그대로)",
      "PER:ADJ(X)[<=N]": "인접 X 1개당 AuxValue(기초) 또는 MultValue(배율) 가산. <=N은 개수 상한",
      "IF:SUM(BASE)>=N": "보드 기초합 N 이상일 때만 발동",
      "UPGRADE:COUNT(TAG:X)>=N": "조건 미달 시 MultValue, 충족 시 AuxValue 사용",
      "CHARGES:N": "N회 발동 후 심볼 영구 소멸",
      "TURNEND:FUNC(ARG)": "턴 종료 시 보드 조작 효과 (엔진 하드코드 케이스)"
    },
    "empty_number": 0,
    "empty_string": "NONE",
    "id_rule": "ID는 불변. 삭제 대신 Enabled=FALSE. 신규는 뒤에 추가"
  },
