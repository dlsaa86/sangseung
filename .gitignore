# ── Unity generated ────────────────────────────────────────────────
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Never ignore Packages/ itself — manifest.json and packages-lock.json are project state.
/[Aa]ssets/AssetStoreTools*

# ── Capture harness output ─────────────────────────────────────────
# Screenshots and manifests are run evidence, not source. They are large,
# regenerable, and would bloat history fast. Keep them on disk, out of git.
/Captures/

# ── IDE / OS ───────────────────────────────────────────────────────
.vs/
.idea/
.vscode/
*.csproj
*.unityproj
*.sln
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

.DS_Store
Thumbs.db
ehthumbs.db

# ── Unity crash / build artifacts ──────────────────────────────────
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.unitypackage
*.app
PlaytestLogs/

Captures/

# 훅이 기록하는 로컬 검증 마커 (머신 종속)
.claude/state/

# ── 에이전트 도구 산출물 ────────────────────────────────────────────
# graphify 지식 그래프와 serena 인덱스는 재생성 가능한 캐시다.
# 기기·세션마다 달라지므로 추적하면 diff만 지저분해진다.
/graphify-out/
/.serena/

# Blender 자동 백업 — 저장할 때마다 바뀐다
*.blend1

# Game Studios — 세션 로그는 기기 종속 잡음이다
production/session-logs/

# Python 바이트코드
__pycache__/

# prime-agent — 세션·데몬 상태는 기기 종속. 설정(.prime/agent/settings.json)만 추적한다
.prime/agent/sessions/
.prime/agent/state/
.prime/agent/*.log
